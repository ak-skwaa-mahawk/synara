{
  "name": "@synara/mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol adapter for the ISST-TOFT Rust/Candle inference backend",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "synara-mcp": "./dist/index.js"
  },
  "scripts": {
